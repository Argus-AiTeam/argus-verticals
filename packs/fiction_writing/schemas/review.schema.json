{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "literary_review",
  "description": "The structured review the reviewer writes to fiction/review.json and the revise stage consumes. `severity` (critical|major|minor|note) is the IMPORTANCE axis; `blocking` is the INDEPENDENT gate axis, so a serious-but-non-gating craft note (critical, non-blocking) and a hard continuity contradiction (blocking) are both expressible. `type` must be one of the fiction finding types; fiction.py review checks it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["revise", "done"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "severity", "blocking", "location", "evidence", "suggested_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["critical", "major", "minor", "note"]},
          "blocking": {"type": "boolean"},
          "location": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "violated_constraint": {"type": "string"},
          "suggested_action": {"type": "string", "minLength": 1},
          "must_not_break": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
